# Contact-form backend endpoint (Netlify Forms).
# Set this in Cloudflare Pages → Settings → Environment variables to the URL of
# the companion Netlify deploy that registers the "opportunity" form, including
# the trailing slash. Leave unset for a Netlify-hosted deploy or local dev
# (falls back to "/").
#
# VITE_FORM_ENDPOINT=https://rb-capital.netlify.app/
